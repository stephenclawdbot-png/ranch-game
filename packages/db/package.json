{
  "name": "@thoroughbred/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "generate": "drizzle-kit generate && node scripts/bundle-migrations.mjs",
    "generate:custom": "drizzle-kit generate --custom && node scripts/bundle-migrations.mjs",
    "bundle-migrations": "node scripts/bundle-migrations.mjs",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@neondatabase/serverless": "1.2.0",
    "@thoroughbred/game-core": "workspace:*",
    "@thoroughbred/shared": "workspace:*",
    "drizzle-orm": "0.44.7",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11"
  }
}
