{
  "name": "@thoroughbred/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "hardhat compile --quiet && tsc -p . --noEmit",
    "coverage": "SOLIDITY_COVERAGE=true hardhat coverage",
    "deploy:robinhood": "hardhat run scripts/deploy.ts --network robinhood"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition-viem": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox-viem": "3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/hardhat-viem": "^2.1.5",
    "@openzeppelin/contracts": "5.7.0",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.20.5",
    "chai": "^4.5.0",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "viem": "2.57.11"
  },
  "description": "Robinhood Chain (EVM) contracts + server chain adapter for Project Thoroughbred. Web3 is optional and off by default.",
  "exports": {
    "./adapter": "./adapter/index.ts",
    "./package.json": "./package.json"
  }
}
