# Secret used to derive race seeds (HMAC) and sign quick-race ids. Use a long random string.
# Generate one with: openssl rand -hex 32
RACE_SEED_SECRET=

# Postgres connection string (Neon, via the Vercel Marketplace integration). Leave EMPTY for
# local dev / tests / previews: the app then uses an embedded PGlite database (persisted under
# node_modules/.cache in `next dev`, in-memory and reset on every cold start on Vercel).
# Production MUST set this. Migrations apply automatically on first use (DB_AUTO_MIGRATE=0 to
# disable and run `pnpm --filter @thoroughbred/db migrate` at deploy time instead).
DATABASE_URL=
