# Vercel Cron backstop for the Live card (GET /api/cron/race-card checks
# `Authorization: Bearer $CRON_SECRET`). Set it in Vercel (Production + Preview); without it the
# cron route answers 503 and the card is still driven lazily on reads. Generate: openssl rand -hex 32
CRON_SECRET=

# Race seeds are random per race and committed in the database (packages/db); this secret is
# only used by the legacy stateless demo in tools/balance/legacy.
# RACE_SEED_SECRET=

# Postgres (Neon via the Vercel Marketplace integration; Vercel sets these for Preview and
# Production). Runtime queries use DATABASE_URL (pooled); `pnpm build` applies migrations with
# DATABASE_URL_UNPOOLED and skips that step when it is unset. Leave both EMPTY locally:
# `next dev` and tests use an embedded PGlite database (persisted under node_modules/.cache).
# A production server without DATABASE_URL refuses to start; for a local `next start`, set
# ALLOW_EMBEDDED_DB=1 to use PGlite in memory instead.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------------------------
# Market seller requirements (§4b). There is no email flow yet, so a verified email is NOT
# required unless MARKET_REQUIRE_VERIFIED_EMAIL=1. Account age and races run stay required.
# MARKET_REQUIRE_VERIFIED_EMAIL=0
# MARKET_SELLER_MIN_ACCOUNT_DAYS=7
# MARKET_SELLER_MIN_RACES=20

# ---------------------------------------------------------------------------------------------
# Closed playtest. PLAYTEST_MODE=1: founding a stable needs an invite code (generated in /admin).
# PLAYTEST_MODE=0
# PLAYTEST_TESTER_CAP=60
# /admin is enabled only when ADMIN_SECRET is set (12+ characters). SECRET: Vercel env only.
# ADMIN_SECRET=
# Manual (fallback) tester payout ledger in /admin: optional budget cap (USD) and tx explorer.
# BETA_BUDGET_USD=
# ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
# Local QA of a production build only: lets POST /api/market/test-seller run (never on Vercel).
# ALLOW_TEST_FIXTURES=0

# ---------------------------------------------------------------------------------------------
# Closed-beta money on Robinhood Chain (docs/web3.md "Beta money flow"). OFF by default: with
# WEB3_ENABLED unset the game runs on a mock chain and the Premium Pack shows "coming soon".
# All SERVER-ONLY (no NEXT_PUBLIC_): the APIs hand the browser the chain id and addresses.
# Deploy the contracts from your own wallet on /admin/chain, then paste the addresses here.
# ---------------------------------------------------------------------------------------------
# "true" = real ETH checkout + on-chain Prize Pool. Anything else = mock chain.
# WEB3_ENABLED=false
# 46630 = Robinhood Chain Testnet (default), 4663 = mainnet, 31337 = local Hardhat.
# CHAIN_ID=46630
# JSON-RPC endpoint. The public RPC is rate-limited; use a provider URL (e.g. Alchemy) for real use.
# ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
# From /admin/chain after deploying (PremiumStore + PrizePool).
# PREMIUM_STORE_ADDRESS=
# PRIZE_POOL_ADDRESS=
# SECRET (Vercel env only, never commit). A DEDICATED LOW-VALUE key, used only to sign 5-minute
# price quotes (SIGNER_ROLE) and, if you grant it POSTER_ROLE + a little gas, to post weekly
# Prize Pool roots. It can never move pool or treasury funds. Generate a fresh key for it:
#   node -e "console.log(require('viem/accounts').generatePrivateKey())"   (in apps/web)
# QUOTE_SIGNER_PRIVATE_KEY=
# ETH/USD: median of public spot prices (auto = coinbase,kraken,bitstamp,binance), refused if the
# sources diverge by more than 2% or leave [ETH_USD_MIN, ETH_USD_MAX]. fixed:<usd> for local dev.
# ETH_USD_PRICE_SOURCE=auto
# ETH_USD_MIN=100
# ETH_USD_MAX=100000
# ETH_USD_MAX_DIVERGENCE_BPS=200
# Premium Pack price in USD cents (converted to wei at quote time).
# PREMIUM_PACK_USD_CENTS=499
# Paid packs are not sold in these countries (Vercel geo header; confirm the list with counsel).
# PREMIUM_BLOCKED_COUNTRIES=BE,NL
# Confirmations before a purchase is fulfilled (soft confirmation is fine for packs).
# CHAIN_MIN_CONFIRMATIONS=1
# Backstop log scan window (blocks) for paid-but-unconfirmed orders.
# CHAIN_LOG_LOOKBACK_BLOCKS=200000
#
# USDG horse market (docs/usdg-market.md, testnet first). Live when WEB3_ENABLED=true AND
# HORSE_MARKET_ADDRESS is set (deploy: pnpm --filter @thoroughbred/contracts deploy:horse-market).
# QUOTE_SIGNER_PRIVATE_KEY signs the orders: grant its address SIGNER_ROLE (the deploy script does).
# HORSE_MARKET_ADDRESS=
# Defaults to Paxos USDG on Robinhood testnet (0x7E95...802F) when CHAIN_ID=46630.
# USDG_TOKEN_ADDRESS=
# Must equal the contract's feeBps (default 500 = 5%), or signed sales revert.
# USDG_FEE_BPS=500
# USDG_MIN_STARTS=5
# USDG_REGISTRATION_FEE=2
# USDG_MIN_PRICE=1
# USDG_PAYMENT_WINDOW_HOURS=24
# USDG_NONPAYER_BAR_DAYS=7
# Dev and tests always run the USDG market on a mock chain (payments simulated). "1" allows that
# on a production build without WEB3 too: NEVER where real players are (a simulated payment moves
# a horse for free). Unset in production = the USDG tab shows "coming soon".
# USDG_MOCK_PAY=
#
# Real-money tote (docs/usdg-tote.md): a DORMANT scaffold. OFF unless REAL_TOTE_ENABLED=true AND
# WEB3_ENABLED=true AND TOTE_POOLS_ADDRESS is set, plus the settings below. Never switch it on
# before every item of the enable checklist in docs/usdg-tote.md (legal approval first).
# REAL_TOTE_ENABLED=false
# TOTE_POOLS_ADDRESS=
# OPERATOR_ROLE key (creates markets, posts results; can never move stakes). SECRET.
# TOTE_OPERATOR_PRIVATE_KEY=
# PERMIT_SIGNER_ROLE key (signs BetPermits). SECRET; must differ from the operator key.
# TOTE_PERMIT_SIGNER_PRIVATE_KEY=
# Where real-money betting is allowed (ISO codes; an allow-list: empty = nowhere).
# REAL_TOTE_ALLOWED_COUNTRIES=
#
# Optional: the canonical site URL for referral links (defaults to the request origin).
# PUBLIC_BASE_URL=https://ranch-game.vercel.app
#
# WalletConnect for wallet sign-in / linking (optional). A free project ID from
# https://cloud.reown.com lets players use phone wallets (Robinhood Wallet, MetaMask,
# Rainbow...) by scanning a QR. NEXT_PUBLIC_ = the browser needs it; leave it unset and only
# injected browser wallets are offered (EIP-6963; Robinhood Wallet's in-app browser injects
# one). The library is loaded on click, so it costs nothing when unset.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
#
# Older optional web3 pieces (fairness anchoring, USDG checkout; packages/contracts adapter):
# RACE_PROOF_REGISTRY_ADDRESS=
# PAYMENT_TOKEN_ADDRESS=
# CHAIN_PURCHASE_FINALITY=latest
# CHAIN_PUBLISHER_PRIVATE_KEY=
# STORE_SIGNER_PRIVATE_KEY=
