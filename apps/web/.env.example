# Secret used to derive race seeds (HMAC) and sign quick-race ids. Use a long random string.
# Generate one with: openssl rand -hex 32
RACE_SEED_SECRET=

# Postgres (Neon via the Vercel Marketplace integration; Vercel sets these for Preview and
# Production). Runtime queries use DATABASE_URL (pooled); `pnpm build` applies migrations with
# DATABASE_URL_UNPOOLED and skips that step when it is unset. Leave both EMPTY locally:
# `next dev` and tests use an embedded PGlite database (persisted under node_modules/.cache).
# A production server without DATABASE_URL refuses to start; for a local `next start`, set
# ALLOW_EMBEDDED_DB=1 to use PGlite in memory instead.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
