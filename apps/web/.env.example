# Vercel Cron backstop for the Live card (GET /api/cron/race-card checks
# `Authorization: Bearer $CRON_SECRET`). Set it in Vercel (Production + Preview); without it the
# cron route answers 503 and the card is still driven lazily on reads. Generate: openssl rand -hex 32
CRON_SECRET=

# Race seeds are random per race and committed in the database (packages/db); this secret is
# only used by the legacy stateless demo in tools/balance/legacy.
# RACE_SEED_SECRET=

# Postgres (Neon via the Vercel Marketplace integration; Vercel sets these for Preview and
# Production). Runtime queries use DATABASE_URL (pooled); `pnpm build` applies migrations with
# DATABASE_URL_UNPOOLED and skips that step when it is unset. Leave both EMPTY locally:
# `next dev` and tests use an embedded PGlite database (persisted under node_modules/.cache).
# A production server without DATABASE_URL refuses to start; for a local `next start`, set
# ALLOW_EMBEDDED_DB=1 to use PGlite in memory instead.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------------------------
# Market seller requirements (§4b). There is no email flow yet, so a verified email is NOT
# required unless MARKET_REQUIRE_VERIFIED_EMAIL=1. Account age and races run stay required.
# MARKET_REQUIRE_VERIFIED_EMAIL=0
# MARKET_SELLER_MIN_ACCOUNT_DAYS=7
# MARKET_SELLER_MIN_RACES=20

# ---------------------------------------------------------------------------------------------
# Closed playtest. PLAYTEST_MODE=1: founding a stable needs an invite code (generated in /admin).
# PLAYTEST_MODE=0
# PLAYTEST_TESTER_CAP=60
# /admin is enabled only when ADMIN_SECRET is set (12+ characters). SECRET: Vercel env only.
# ADMIN_SECRET=
# Manual (fallback) tester payout ledger in /admin: optional budget cap (USD) and tx explorer.
# BETA_BUDGET_USD=
# ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
# Local QA of a production build only: lets POST /api/market/test-seller run (never on Vercel).
# ALLOW_TEST_FIXTURES=0

# ---------------------------------------------------------------------------------------------
# Optional web3: Robinhood Chain (EVM). OFF by default; the game works fully without it.
# See docs/web3.md. All of these are SERVER-ONLY (no NEXT_PUBLIC_ prefix). The checkout API
# hands the browser the store address + chain id. Leave everything below unset in dev.
# ---------------------------------------------------------------------------------------------
# "true" enables the real chain adapter. Anything else (default) uses the in-memory mock.
# WEB3_ENABLED=false
# JSON-RPC endpoint. The public RPC is rate-limited (not for production); use a provider URL.
# ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
# 46630 = Robinhood Chain Testnet (default), 4663 = mainnet.
# ROBINHOOD_CHAIN_ID=46630
# Deployed contract addresses (from packages/contracts deployments/<chainId>.json).
# PREMIUM_STORE_ADDRESS=
# RACE_PROOF_REGISTRY_ADDRESS=
# Stablecoin for display balances. Testnet USDG (Paxos, 6 decimals): 0x7E955252E15c84f5768B83c41a71F9eba181802F
# PAYMENT_TOKEN_ADDRESS=
# Purchase confirmation policy: confirmations >= N and finality latest | safe | finalized.
# CHAIN_MIN_CONFIRMATIONS=1
# CHAIN_PURCHASE_FINALITY=latest
# SECRETS: set only in Vercel env (never commit). 0x-prefixed 32-byte hex keys.
# Holds PUBLISHER_ROLE on RaceProofRegistry (posts fairness proof roots).
# CHAIN_PUBLISHER_PRIVATE_KEY=
# Holds SIGNER_ROLE on PremiumStore (signs EIP-712 purchase vouchers).
# STORE_SIGNER_PRIVATE_KEY=
