{
  "name": "@thoroughbred/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node --experimental-websocket ../../packages/db/scripts/migrate.mjs && node scripts/art-index.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "art-index": "node scripts/art-index.mjs",
    "test:chain": "CHAIN_E2E=1 vitest run src/server/chain/chain-e2e.test.ts"
  },
  "dependencies": {
    "@thoroughbred/art-pipeline": "workspace:*",
    "@thoroughbred/db": "workspace:*",
    "@thoroughbred/game-core": "workspace:*",
    "@thoroughbred/pixel-rig": "workspace:*",
    "@thoroughbred/race-viewer": "workspace:*",
    "@thoroughbred/racing-engine": "workspace:*",
    "@thoroughbred/shared": "workspace:*",
    "@walletconnect/ethereum-provider": "2.26.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sharp": "0.35.5",
    "viem": "2.57.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "tailwindcss": "4.3.3"
  }
}
