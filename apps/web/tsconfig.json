{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "preserve"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-redesign/types/**/*.ts",
    ".next-viewer/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-db/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-*"
  ]
}
